# Host IP the web UIs bind to (e.g. 192.168.1.10)
IP=
PUID=1000
PGID=1000
TZ=Etc/UTC
# App config folders live under this path
BASE_PATH=/opt/media-stack
# Root of downloads + media, mounted as /data so hardlinks work
MEDIA_SHARE=/srv/data
# Homarr encryption key, generate with: openssl rand -hex 32
SECRET_HOMARR=
